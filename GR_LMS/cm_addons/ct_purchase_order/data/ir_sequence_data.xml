<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_ct_purchase_order" model="ir.sequence">
        <field name="name">CT Purchase Order</field>
        <field name="code">ct.purchase.order</field>
        <field name="prefix">PO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <record id="seq_ct_purchase_order_draft" model="ir.sequence">
        <field name="name">CT Purchase Order Draft</field>
        <field name="code">ct.purchase.order.draft</field>
        <field name="prefix">POD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
