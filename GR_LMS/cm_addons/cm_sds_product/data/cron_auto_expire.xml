<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="cron_update_expired_status" model="ir.cron">
            <field name="name">SDS Product Update Expired Status</field>
            <field name="model_id" ref="model_cm_sds_product"/>
            <field name="state">code</field>
            <field name="code">model.auto_entry_expire()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field> <!-- Runs daily -->
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
