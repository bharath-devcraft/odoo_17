<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_ct_purchase_request" model="ir.sequence">
        <field name="name">Purchase Request</field>
        <field name="code">ct.purchase.request</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <record id="seq_ct_purchase_request_draft" model="ir.sequence">
        <field name="name">Purchase Request Draft</field>
        <field name="code">ct.purchase.request.draft</field>
        <field name="prefix">PRD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
