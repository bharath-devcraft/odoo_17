<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="cron_quotation_bc_pending_mail" model="ir.cron">
            <field name="name">Quotation BC Pending Mail</field>
            <field name="model_id" ref="model_ct_quotations_scheduler"/>
            <field name="state">code</field>
            <field name="code">model.quotations_bc_pending_scheduler_mail()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field> <!-- Runs daily -->
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
