<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_ct_grn" model="ir.sequence">
        <field name="name">CT GRN</field>
        <field name="code">ct.grn</field>
        <field name="prefix">GRN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <record id="seq_ct_grn_draft" model="ir.sequence">
        <field name="name">CT GRN Draft</field>
        <field name="code">ct.grn.draft</field>
        <field name="prefix">GRND/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
