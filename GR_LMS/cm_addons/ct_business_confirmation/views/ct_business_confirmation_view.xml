<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="ct_business_confirmation_form">
      <field name="name">Form View</field>
      <field name="model">ct.business.confirmation</field>
      <field name="arch" type="xml">
        <form string="Business Confirmation" create="false">
            <header>

                <button string="Confirm"
                    class="btn btn-primary"
                    type="object"
                    name="entry_confirm" invisible = "status != 'draft'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Approve"
                    icon="fa-thumbs-up"
                    class="btn btn-success"
                    type="object"
                    name="entry_approve" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Reject"
                    icon="fa-thumbs-down"
                    class="btn btn-danger"
                    type="object"
                    name="entry_reject" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Cancel"
                    class="btn btn-primary"
                    type="object"
                    name="entry_cancel" invisible = "status != 'approved'"
                    confirm="Are you sure to proceed ?"/>

                <field name="status" widget="statusbar" style="width:700px;"/>                

            </header>
            <sheet>
                <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible = "status != 'approved'"/>
                <group>
                    <group>
                        <field name="name" readonly = "1" force_save="1" class="animate-charcter" widget="CopyClipboardChar"/>
                        <field name="entry_date" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="po_no" readonly = "status not in ('draft','wfa')"/>
                        <field name="po_date" readonly = "status not in ('draft','wfa')"/>
                    </group>
                    <group>
                        <field name="qs_no" readonly = "1" force_save="1"/>
                        <field name="qs_date" readonly = "1" force_save="1"/>
                        <field name="service_id" readonly = "1" force_save="1" options="{'no_create': True}"/>
                    </group>
                </group>
                <group string="Customer Details">
                    <group>
                        <field name="customer_id" readonly = "1" force_save="1" options="{'no_create': True}"/>
                        <field name="cus_bill_address" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="cus_del_address" readonly = "1" force_save="1"/>
                        <field name="cpcb_registered" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Customer Emergency Contact Details">
                    <group>
                        <field name="contact_person" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="mobile_no" required = "1" readonly = "status not in ('draft','wfa')"/>
                    </group>
                    <group>
                        <field name="email" required = "1" readonly = "status not in ('draft','wfa')"/>
                    </group>
                </group>
                <group string="Product Details" invisible="'FLBS' not in combined_codes">
                    <group>
                        <field name="product_id" readonly = "1" force_save="1" options="{'no_create': True}"/>
                        <field name="dg_product" readonly = "1" force_save="1"/>
                        <field name="un_no" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="imo_class" readonly = "1" force_save="1"/>
                        <field name="pack_grp" readonly = "1" force_save="1"/>
                        <field name="sds_attach_ids" widget="single_file_binary" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Vendor Details" invisible="'FLBS' not in combined_codes">
                    <group>
                        <field name="vendor_id" readonly = "1" force_save="1" options="{'no_create': True}"/>
                        <field name="accessories_req" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="bill_address" readonly = "1" force_save="1"/>
                        <field name="del_address" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Quotation Details">
                    <group>
                        <field name="payment_mode" required = "1" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="qs_remark" readonly="1" force_save="1"/>
                    </group>
                </group>
                <group string="Other Details">
                    <group>
                        <field name="service_ids" widget="many2many_tags" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="spl_req" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="combined_codes" readonly = "1" force_save="1" invisible="1"/>
                        <field name="currency_id" readonly="1" options="{'no_create': True}" invisible="1" force_save="1"/>
                    </group>
                    <group>
                        <field name="status" readonly = "1" force_save="1" invisible="1"/>
                    </group>
                </group>

                <group string="Operational Service Details" invisible="'FLOS' not in combined_codes">
                    <group>
                        <field name="operational_type" readonly = "1" force_save="1"/>
                        <field name="flexi_stuff_qty" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="stuff_date" readonly = "1" force_save="1"/>
                        <field name="stuff_address" readonly = "1" force_save="1"/>
                    </group>
                </group>

                
                <notebook>
                    <page string="Flexi and Accessories Details" invisible="'FLAS' not in combined_codes and 'FLBS' not in combined_codes">
                        <field name="line_ids_c" string="Flexi and Accessories Details" colspan="4" nolabel="1" readonly = "1" force_save="1">
                            <tree string="Flexi and Accessories Details">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="accessory_set_id" column_invisible="1"/>
                                <field name="flexi_type"/>
                                <field name="flexi_layer_type_id"/>
                                <field name="flexi_capacity_id"/>
                                <field name="qty" width="200px"/>
                                <field name="bag_req_date"  width="200px"/>
                                <field name="pod_services"/>
                                <field name="line_count" string="No of Accessories" width="200px" column_invisible="1"/>
                            </tree>
                            <form string="Flexi and Accessories Details">
                                <group>
                                    <group>
                                        <field name="status" invisible="1"/>
                                        <field name="header_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="accessory_set_id" options="{'no_create': True}"/>
                                        <field name="flexi_type"/>
                                        <field name="flexi_layer_type_id" options="{'no_create': True}"/>
                                        <field name="flexi_capacity_id" options="{'no_create': True}"/>
                                        <field name="line_count" string="No of Accessories"/>
                                        <field name="qty"/>
                                    </group>  
                                    <group>
                                        <field name="bag_req_date"/>
                                        <field name="pod_services"/>
                                        <field name="vendor_id" options="{'no_create': True}"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Details">
                                        <field name="line_ids" nolabel="1" readonly = "1" force_save="1" create="0" delete="0">
                                            <tree editable="bottom">   
                                                <field name="status" column_invisible="1"/>
                                                <field name="header_id" column_invisible="1"/>
                                                <field name="company_id" column_invisible="1"/>
                                                <field name="accessories_id" options="{'no_create': True}"/>
                                                <field name="uom_id" options="{'no_create': True}"/>
                                                <field name="qty"/>
                                            </tree>
                                        </field>
                                    </page>
                                    <page string="More Info">
                                        <group>
                                            <group>
                                                <field name="pending_qty" readonly="1"/>
                                            </group>
                                            <group >
                                            </group>
                                        </group>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                    </page>
                </notebook>

                <notebook>                       
                    <page string="Customer Price Details">
                        <field name="line_ids_e" string="Customer Price Details" colspan="4" nolabel="1" readonly = "1" force_save="1">
                            <tree string="Customer Price Details" editable="bottom" create="0">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="chrg_head_id" options="{'no_create': True}"/>
                                <field name="description" />
                                <field name="uom_id" options="{'no_create': True}"/>
                                <field name="qty" />
                                <field name="unit_price" readonly="1"/>
                                <field name="currency_id" readonly="1" options="{'no_create': True}" />
                                <field name="taxable_amt" />
                                <field name="tax_ids" readonly="1" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="tax_amt" readonly="1"/>
                                <field name="tot_amt" width="200px" readonly="1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Attachments" >
                        <field name="line_ids_a" string="Attachments" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Attachments" editable="bottom">

                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="attach_desc" required="1"/>
                                <field name="attachment_ids" required="1" widget="single_file_binary" options="{'no_create_edit': True}"/>
                                <field name="attach_user_id" readonly = "1" force_save="1"/>
                                <field name="attach_date" readonly = "1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Approve / Reject Remarks">
                        <group>
                            <field name="ap_rej_remark" nolabel="1" style="width:1000px;" readonly = "status in ('approved','cancelled','rejected')"/>
                        </group>
                    </page>
                    <page string="Cancel Remarks">
                        <group>
                            <field name="cancel_remark" nolabel="1" style="width:1000px;" readonly = "status in ('cancelled','rejected')"/>
                        </group>
                    </page>
                    <page string="More Info">
                        <group>
                            <group>
                                <field name="invoiced_amt" readonly = "1" force_save="1"/>
                                <field name="invoice_status" readonly = "1" force_save="1"/>
                            </group>
                            <group>
                                <field name="issue_status" readonly = "1" force_save="1"/>
                            </group>
                        </group>
                    </page>
                    <page string="Entry Info">
                        <group>
                            <group>
                                <field name="company_id" force_save="1"/> 
                                <field name="fy_control_date" readonly = "1" force_save="1"/>
                                <field name="active_rpt"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="entry_mode" force_save="1"/>
                                <field name="active_trans"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="confirm_user_id" invisible="status == 'draft'" widget="many2one_avatar_user" />
                                <field name="ap_rej_user_id" invisible="status in ('draft','wfa')" widget="many2one_avatar_user" />
                                <field name="cancel_user_id" invisible="status != 'cancelled'" widget="many2one_avatar_user" />
                                <field name="update_user_id" widget="many2one_avatar_user" />
                            </group>
                            <group>
                                <field name="crt_date" />
                                <field name="confirm_date" invisible="status == 'draft'" />
                                <field name="ap_rej_date" invisible="status in ('draft','wfa')" />
                                <field name="cancel_date" invisible="status != 'cancelled'" />
                                <field name="update_date" />
                            </group>
                        </group>
                    </page>
                </notebook>
                <group>
                    <group>
                        <group string="Tax Breakup Value" style="margin-left:1px;">
                            <field name="line_ids_g" string="Tax Breakup Value" colspan="2" nolabel="1" readonly = "1" force_save="1">
                            <tree string="Tax Breakup Value" editable="top">
                                <field name="tax_name" readonly = "1" force_save="1"/>
                                <field name="tax_amt" string="Value" readonly = "1" force_save="1" sum="Total"/>
                            </tree>
                            </field>
                        </group>
                    </group>
                    <group class="oe_subtotal_footer" style="width:350px;">
                        <field name="tot_amt" colspan="2" readonly="1" force_save="1" class="bold-text"/>
                        <field name="disc_amt" colspan="2" readonly="1" force_save="1"/>
                        <field name="taxable_amt" colspan="2" readonly="1" force_save="1"/>
                        <field name="tax_amt" colspan="2" readonly="1" force_save="1"/>                          
                        <label for="grand_tot_amt" class="footer-total-label"/>
                        <div>
                            <field name="grand_tot_amt" class="footer-total-value" colspan="2" readonly="1" force_save="1"/>
                        </div>
                        <field name="fixed_disc_amt" colspan="2" force_save="1" readonly = "entry_mode == 'auto' or status not in ('draft','wfa') or grand_tot_amt &lt;= 0"/>
                        <field name="round_off_amt" colspan="2" readonly = "1" force_save="1"/>
                        <label for="net_amt" class="footer-total-label"/>
                        <div>
                            <field name="net_amt" string="Total Amount" colspan="2" readonly = "1" force_save="1" widget="monetary" class="custom_oe_subtotal_footer_separator"/>
                        </div>
                        <field name="manual_round_off" colspan="2" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <br/>
                <notebook>
                    <page string="Terms and Conditions" >
                        <field name="line_ids_f" string="Terms and Conditions" colspan="4" nolabel="1" readonly = "1" force_save="1">
                            <tree string="Terms and Conditions" editable="bottom">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="description"/>
                            </tree>
                        </field>
                    </page>                                                
                </notebook>
                <br/>
                <group>
                    <field name="remarks"/>
                </group>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>  
            </sheet>
        </form>
      </field>
    </record>

    <record id="ct_business_confirmation_tree_js" model="ir.ui.view">
        <field name="name">List Dashboard View</field>
        <field name="model">ct.business.confirmation</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <tree string="Business Confirmation" js_class="ct_business_confirmation_list"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'" create="false">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="qs_no"/>
                <field name="qs_date"/>
                <field name="service_id"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="ct_business_confirmation_tree" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">ct.business.confirmation</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <tree string="Business Confirmation"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'" create="false">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="qs_no"/>
                <field name="qs_date"/>
                <field name="service_id"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="ct_business_confirmation_search" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">ct.business.confirmation</field>
        <field name="arch" type="xml">
            <search string="Business Confirmation">
                <field name="name"/>
                <field name="po_no"/>
                <field name="qs_no"/>

                <filter name="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="WFA" domain="[('status', '=', 'wfa')]"/>
                <filter name="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter name="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="my_entries" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <filter name="My Draft" string="My Draft" domain="[('user_id', '=', uid),('status', '=', 'draft')]"/>
                <filter name="My WFA" string="My WFA" domain="[('user_id', '=', uid),('status', '=', 'wfa')]"/>
                <filter name="My Approved" string="My Approved" domain="[('user_id', '=', uid),('status', '=', 'approved')]"/>
                <filter name="My Cancelled" string="My Cancelled" domain="[('user_id', '=', uid),('status', '=', 'cancelled')]"/>
                <filter name="My Rejected" string="My Rejected" domain="[('user_id', '=', uid),('status', '=', 'rejected')]"/>
                <filter name="Hidden" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="BC Date" name="entry_date" domain="[]" context="{'group_by': 'entry_date'}"/>
                    <filter string="Service Name" name="service_id" domain="[]" context="{'group_by': 'service_id'}"/>
                    <filter string="Customer Name" name="customer_id" domain="[]" context="{'group_by': 'customer_id'}"/>
                    <filter string="Created By" name="user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Confirmed By" name="confirm_user_id" domain="[]" context="{'group_by': 'confirm_user_id'}"/>
                    <filter string="Approved / Rejected By" name="ap_rej_user_id" domain="[]" context="{'group_by': 'ap_rej_user_id'}"/>
                    <filter string="Cancelled By" name="cancel_user_id" domain="[]" context="{'group_by': 'cancel_user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Entry Mode" name="entry_mode" domain="[]" context="{'group_by': 'entry_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ct_business_confirmation_kanban" model="ir.ui.view">
        <field name="name">Kanban View</field>
        <field name="model">ct.business.confirmation</field>
        <field name="arch" type="xml">
            <kanban string="Business Confirmation" class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="name"/>
                <field name="entry_date"/>
                <field name="status"/>
                <progressbar field="status"
                    colors='{"draft": "info", "wfa": "success", "approved": "bf","cancelled": "primary","rejected": "warning"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="kanban-card"> 
                            <div class="kanban-table">
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'BC No'">
                                        <field style="color: #4d4d4d; font-weight: bold; font-size: 18px;" name="name"/>
                                    </div>
                                    <div class="kanban-cell" t-att-title="'BC Date'">
                                        <field style="color: #808080; font-weight: bold; font-size: 14px;" name="entry_date"/>
                                    </div>
                                </div>
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Status'">
                                        <field name="status" widget="label_selection" options="{'classes': {'draft': 'info', 'wfa': 'success', 'approved': 'default', 'cancelled': 'primary', 'rejected': 'warning'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ct_business_confirmation_graph" model="ir.ui.view">
       <field name="name">Graph View</field>
       <field name="model">ct.business.confirmation</field>
       <field name="arch" type="xml">
            <graph string="Business Confirmation" sample="1" disable_linking="True" stacked="0" type="pie">
                <field name="status"/>
                <field name="id" string="Count" type="measure" operator="count"/>
            </graph>
        </field>
    </record>

    <record id="ct_business_confirmation_win_action" model="ir.actions.act_window" >
      <field name="name">Business Confirmation</field>
      <field name="res_model">ct.business.confirmation</field>
      <field name="view_mode">tree,form,kanban,graph</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="ct_business_confirmation_tree_js"/>
        <field name="search_view_id" ref="ct_business_confirmation_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No record found. Let's create one !
          </p><p>
            This is for base confirmation.
          </p>
        </field>
    </record>

    <record id="ct_view_business_confirmation_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="ct_business_confirmation.ct_business_confirmation_tree_js"/>
        <field name="act_window_id" ref="ct_business_confirmation_win_action"/>
    </record>

    <record id="ct_view_business_confirmation_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ct_business_confirmation.ct_business_confirmation_form"/>
        <field name="act_window_id" ref="ct_business_confirmation_win_action"/>
    </record>

    <record id="ct_view_business_confirmation_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="ct_business_confirmation.ct_business_confirmation_kanban"/>
        <field name="act_window_id" ref="ct_business_confirmation_win_action"/>
    </record>

    <record id="ct_view_business_confirmation_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="ct_business_confirmation.ct_business_confirmation_graph"/>
        <field name="act_window_id" ref="ct_business_confirmation_win_action"/>
    </record>

	<menuitem name="Flexi" id="ct_flexi_m_root" web_icon="ct_business_confirmation,static/description/icon.png" sequence="4"/>
	
	<menuitem name="Flexi Service" id="ct_flexi_m_parent" parent="ct_flexi_m_root" sequence="2"/>
    <menuitem name="Business Confirmation" id="ct_business_confirmation_act_menu" parent="ct_flexi_m_parent"
              action="ct_business_confirmation_win_action" sequence="1"/>
  </data>
</odoo>
