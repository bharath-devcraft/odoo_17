<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="ct_store_issue_form">
      <field name="name">Form View</field>
      <field name="model">ct.store.issue</field>
      <field name="arch" type="xml">
        <form string="Store Issue">
            <header>

                <button string="Confirm"
                    class="btn btn-primary"
                    type="object"
                    name="entry_confirm" invisible = "status != 'draft'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Approve"
                    icon="fa-thumbs-up"
                    class="btn btn-success"
                    type="object"
                    name="entry_approve" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Reject"
                    icon="fa-thumbs-down"
                    class="btn btn-danger"
                    type="object"
                    name="entry_reject" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Cancel"
                    class="btn btn-primary"
                    type="object"
                    name="entry_cancel" invisible = "1"
                    confirm="Are you sure to proceed ?"/>

                <field name="status" widget="statusbar" style="width:700px;"/>                

            </header>
            <sheet>
                <widget name="web_ribbon" title="Draft" bg_color="bg-info" invisible = "status != 'draft'"/>
                <widget name="web_ribbon" title="WFA" bg_color="bg-warning" invisible = "status != 'wfa'"/>
                <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible = "status != 'approved'"/>
                <widget name="web_ribbon" title="Rejected" bg_color="bg-danger" invisible = "status != 'rejected'"/>
                <widget name="web_ribbon" title="Cancelled" bg_color="bg-primary" invisible = "status != 'cancelled'"/>
                <group>
                    <group>
                        <field name="name" readonly = "1" force_save="1" class="animate-charcter" widget="CopyClipboardChar"/>
                        <field name="entry_date" required = "1" readonly = "status not in ('draft','wfa')"/>
                    </group>
                    <group>
                        <field name="issue_type" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="mode_of_issue" required = "1" readonly = "status not in ('draft','wfa')"/>
                    </group>
                </group>
                <group>
                    <group>
                    </group>
                    <group>
                        <field name="line_count" readonly = "1" force_save="1" invisible="1"/>
                        <field name="status" readonly = "1" force_save="1" invisible="1"/>
                    </group>
                </group>

                
                <notebook>
                    <page string="Details" >
                        <field name="line_ids" string="Details" widget="one2many_search" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Details">

                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="description"/>
                                <field name="brand_id"/>
                                <field name="uom_id"/>
                                <field name="qty"/>
                            </tree>
                            <form string="Details">
                                <group>
                                    <group>
                                        <field name="product_id" required="1" force_save="1" options="{'no_create': True}"/>
                                        <field name="description" readonly = "1" force_save="1"/>
                                        <field name="brand_id" options="{'no_create': True}"/>
                                        <field name="uom_id" options="{'no_create': True}"  readonly = "1" force_save="1"/>
                                       
                                    </group>
                                    <group>
                                        
                                        <field name="qty" required="1"/>
                                        <field name="stock_qty" required="1" force_save="1"/>
                                        <field name="remarks"/>
                                        <field name="status" invisible="1"/>
                                        <field name="header_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                    </group>
                                </group>
                                <group string="Lot/Serial No Details">
                                    <group></group>
                                    <group></group>
                                    <field name="lot_ids" nolabel="1" options="{'no_create': 1}">
                                        <tree editable="bottom" >   
                                            <field name="serial_no" width="150px" readonly = "1" force_save="1"/>
                                            <field name="name" string="Ref No" width="150px" readonly = "1" force_save="1"/>
                                            <field name="entry_date" string="Ref Date" width="150px" readonly = "1" force_save="1"/>
                                            <field name="product_id" width="200px" readonly = "1" force_save="1"/>
                                            <field name="brand_id" width="150px" readonly = "1" force_save="1"/>
                                            <field name="store_uom_id" string="UOM"  readonly = "1" force_save="1"/>
                                            <field name="store_pend_qty" string="Qty" readonly = "1" force_save="1"/>
                                            <field name="expiry_date" width="150px" readonly = "1" force_save="1"/>
                                        </tree>
                                    </field>
                                </group>
                                
                                <group string="Utilization">
                                    <group></group>
                                    <group></group>
                                    <field name="line_ids" nolabel="1" readonly="1">
                                        <tree editable="bottom">   
                                            <field name="serial_no" width="150px"/>
                                            <field name="uom_id" width="150px"/>
                                            <field name="grn_qty" string="Available Qty" width="150px"/>
                                            <field name="issue_qty" string="Utilized Qty" width="150px"/> 
                                        </tree>
                                    </field>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Attachments" >
                        <field name="line_ids_a" string="Attachments" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Attachments" editable="bottom">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="attach_desc" required="1"/>
                                <field name="attachment_ids" required="1" widget="single_file_binary" options="{'no_create_edit': True}"/>
                                <field name="attach_user_id" readonly = "1" force_save="1"/>
                                <field name="attach_date" readonly = "1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Approve / Reject Remarks">
                        <group>
                            <field name="ap_rej_remark" nolabel="1" style="width:1000px;" readonly = "status in ('approved','cancelled','rejected')"/>
                        </group>
                    </page>
                    <page string="Cancel Remarks">
                        <group>
                            <field name="cancel_remark" nolabel="1" style="width:1000px;" readonly = "status in ('cancelled','rejected')"/>
                        </group>
                    </page>
                    <page string="Entry Info">
                        <group>
                            <group>
                                <field name="company_id" force_save="1"/> 
                                <field name="fy_control_date" readonly = "1" force_save="1"/>
                                <field name="active_rpt"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="entry_mode" force_save="1"/>
                                <field name="active_trans"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="confirm_user_id" invisible="status == 'draft'" widget="many2one_avatar_user" />
                                <field name="ap_rej_user_id" invisible="status in ('draft','wfa')" widget="many2one_avatar_user" />
                                <field name="cancel_user_id" invisible="status != 'cancelled'" widget="many2one_avatar_user" />
                                <field name="update_user_id" widget="many2one_avatar_user" />
                            </group>
                            <group>
                                <field name="crt_date" />
                                <field name="confirm_date" invisible="status == 'draft'" />
                                <field name="ap_rej_date" invisible="status in ('draft','wfa')" />
                                <field name="cancel_date" invisible="status != 'cancelled'" />
                                <field name="update_date" />
                            </group>
                        </group>
                    </page>
                </notebook>
                <group>
                    <field name="remarks"/>
                </group>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>  
            </sheet>
        </form>
      </field>
    </record>

    <record id="ct_store_issue_tree_js" model="ir.ui.view">
        <field name="name">List Dashboard View</field>
        <field name="model">ct.store.issue</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <tree string="Store Issue" js_class="ct_store_issue_list"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="mode_of_issue"/>
                <field name="line_count"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="ct_store_issue_tree" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">ct.store.issue</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <tree string="Store Issue"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="mode_of_issue"/>
                <field name="line_count"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="ct_store_issue_search" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">ct.store.issue</field>
        <field name="arch" type="xml">
            <search string="Store Issue">
                <field name="name"/>
                <field name="line_ids" string="Products" filter_domain="[('line_ids.product_id','ilike',self)]"/>
                <field name="remarks"/>

                <filter name="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="WFA" domain="[('status', '=', 'wfa')]"/>
                <filter name="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter name="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="my_entries" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <filter name="My Draft" string="My Draft" domain="[('user_id', '=', uid),('status', '=', 'draft')]"/>
                <filter name="My WFA" string="My WFA" domain="[('user_id', '=', uid),('status', '=', 'wfa')]"/>
                <filter name="My Approved" string="My Approved" domain="[('user_id', '=', uid),('status', '=', 'approved')]"/>
                <filter name="My Cancelled" string="My Cancelled" domain="[('user_id', '=', uid),('status', '=', 'cancelled')]"/>
                <filter name="My Rejected" string="My Rejected" domain="[('user_id', '=', uid),('status', '=', 'rejected')]"/>
                <filter name="Hidden" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Issue Date" name="entry_date" domain="[]" context="{'group_by': 'entry_date'}"/>
                    <filter string="Issue Type" name="issue_type" domain="[]" context="{'group_by': 'issue_type'}"/>
                    <filter string="Mode Of Issue" name="mode_of_issue" domain="[]" context="{'group_by': 'mode_of_issue'}"/>
                    <filter string="Created By" name="user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Confirmed By" name="confirm_user_id" domain="[]" context="{'group_by': 'confirm_user_id'}"/>
                    <filter string="Approved / Rejected By" name="ap_rej_user_id" domain="[]" context="{'group_by': 'ap_rej_user_id'}"/>
                    <filter string="Cancelled By" name="cancel_user_id" domain="[]" context="{'group_by': 'cancel_user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Entry Mode" name="entry_mode" domain="[]" context="{'group_by': 'entry_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ct_store_issue_kanban" model="ir.ui.view">
        <field name="name">Kanban View</field>
        <field name="model">ct.store.issue</field>
        <field name="arch" type="xml">
            <kanban string="Store Issue" class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="name"/>
                <field name="entry_date"/>
                <field name="ap_rej_user_id"/>
                <field name="status"/>
                <progressbar field="status"
                    colors='{"draft": "info", "wfa": "success", "approved": "bf","cancelled": "primary","rejected": "warning"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="kanban-card"> 
                            <div class="kanban-table">
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Issue No'">
                                        <field style="color: #4d4d4d; font-weight: bold; font-size: 18px;" name="name"/>
                                    </div>
                                    <div class="kanban-cell" t-att-title="'Issue Date'">
                                        <field style="color: #808080; font-weight: bold; font-size: 14px;" name="entry_date"/>
                                    </div>
                                </div>
                                <div class="kanban-row">
                                    
                                    <div class="kanban-cell" t-att-title="'Approved/Reject By'">
                                        <i class="fa fa-user" style="color: #4CAF50;" title="Supplier Icon"></i> <field name="ap_rej_user_id"/>
                                    </div>
                                </div>
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Status'">
                                        <field name="status" widget="label_selection" options="{'classes': {'draft': 'info', 'wfa': 'success', 'approved': 'default', 'cancelled': 'primary', 'rejected': 'warning'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ct_store_issue_graph" model="ir.ui.view">
       <field name="name">Graph View</field>
       <field name="model">ct.store.issue</field>
       <field name="arch" type="xml">
            <graph string="Store Issue" sample="1" disable_linking="True" stacked="0" type="pie">
                <field name="id" string="Count" type="measure" operator="count"/>
                <field name="line_count" invisible="1"/>
            </graph>
        </field>
    </record>

    <record id="ct_store_issue_dashboard" model="ir.ui.view">
       <field name="name">Dashboard View</field>
       <field name="model">ct.store.issue</field>
       <field name="arch" type="xml">
            <dashboard/>
        </field>
    </record>

    <record id="ct_store_issue_win_actions" model="ir.actions.act_window" >
      <field name="name">Store Issue</field>
      <field name="res_model">ct.store.issue</field>
      <field name="view_mode">tree,dashboard,form,kanban,graph</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="ct_store_issue_tree_js"/>
        <field name="search_view_id" ref="ct_store_issue_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No record found. Let's create one !
          </p><p>
            This is for base transaction.
          </p>
        </field>
    </record>

    <record id="ct_view_store_issue_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="ct_store_issue.ct_store_issue_tree_js"/>
        <field name="act_window_id" ref="ct_store_issue_win_actions"/>
    </record>

    <record id="ct_view_store_issue_dashbord" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">dashboard</field>
        <field name="view_id" ref="ct_store_issue.ct_store_issue_dashboard"/>
        <field name="act_window_id" ref="ct_store_issue_win_actions"/>
    </record>

    <record id="ct_view_store_issue_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ct_store_issue.ct_store_issue_form"/>
        <field name="act_window_id" ref="ct_store_issue_win_actions"/>
    </record>

    <record id="ct_view_store_issue_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="ct_store_issue.ct_store_issue_kanban"/>
        <field name="act_window_id" ref="ct_store_issue_win_actions"/>
    </record>

    <record id="ct_view_store_issue_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="ct_store_issue.ct_store_issue_graph"/>
        <field name="act_window_id" ref="ct_store_issue_win_actions"/>
    </record>

    <menuitem name="Store Issue" id="ct_store_issue_act_menu" parent="ct_grn.ct_inventory_in_out_entry_m_parent"
              action="ct_store_issue_win_actions" sequence="4"/>
  </data>
</odoo>
