<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_ct_pipo_entry" model="ir.sequence">
        <field name="name">CT PI-PO Creation</field>
        <field name="code">ct.pipo.entry</field>
        <field name="prefix">PP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <record id="seq_ct_pipo_entry_draft" model="ir.sequence">
        <field name="name">CT PI-PO Creation Draft</field>
        <field name="code">ct.pipo.entry.draft</field>
        <field name="prefix">PPD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
