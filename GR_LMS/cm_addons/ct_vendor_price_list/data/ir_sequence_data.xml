<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_ct_vendor_price_list" model="ir.sequence">
        <field name="name">CT Vendor Price List</field>
        <field name="code">ct.vendor.price.list</field>
        <field name="prefix">CT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <record id="seq_ct_vendor_price_list_draft" model="ir.sequence">
        <field name="name">CT Vendor Price List Draft</field>
        <field name="code">ct.vendor.price.list</field>
        <field name="prefix">CTD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
