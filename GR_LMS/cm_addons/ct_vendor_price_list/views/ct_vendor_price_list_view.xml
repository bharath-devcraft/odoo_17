<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="ct_vendor_price_list_form">
      <field name="name">Form View</field>
      <field name="model">ct.vendor.price.list</field>
      <field name="arch" type="xml">
        <form string="Price List">
            <header>

                <button string="Confirm"
                    class="btn btn-primary"
                    type="object"
                    name="entry_confirm" invisible = "status != 'draft'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Approve"
                    icon="fa-thumbs-up"
                    class="btn btn-success"
                    type="object"
                    name="entry_approve" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Reject"
                    icon="fa-thumbs-down"
                    class="btn btn-danger"
                    type="object"
                    name="entry_reject" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Expiry"
                    class="btn btn-warning"
                    type="object"
                    name="entry_expiry" invisible = "status != 'approved'"
                    confirm="Are you sure to proceed ?"/>

                <field name="status" widget="statusbar" style="width:700px;"/>                

            </header>
            <sheet>
                <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible = "status != 'approved'"/>
                <group>
                    <group>
                        <field name="ref_no" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="entry_date" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="vendor_id" options="{'no_create': 1}" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="vendor_name" invisible="1" readonly="status not in ('draft','wfa')"/>
                        <field name="source" required="1" readonly="1"/>
                        <field name="comparison_ref_no" readonly='1' force_save='1' invisible="source != 'comparison'"/>
                        <field name="bill_type" required='1' readonly="status not in ('draft','wfa')"/>
                        <field name="is_validity" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="validity_period" readonly="status not in ('draft','wfa')" invisible="is_validity == 'no_limit'" required="is_validity != 'no_limit'"/>
                        <field name="validity_period_days" readonly="status not in ('draft','wfa')" invisible="is_validity == 'no_limit'" required="is_validity != 'no_limit'"/>
                        <field name="validity_date" force_save="1" readonly="1" invisible="is_validity == 'no_limit'"/>
                        <field name="is_warranty" readonly="status not in ('draft','wfa')"/>
						<field name="warranty_category" readonly="status not in ('draft','wfa')" required="is_warranty == 'applicable'" invisible="is_warranty != 'applicable'"/>
                        <field name="warranty_from" force_save="1" readonly="status not in ('draft','wfa')" invisible="warranty_category == False" required="warranty_category in ('limited','perpetual')"/>
                        <field name="warranty_period" force_save="1" readonly="status not in ('draft','wfa')" invisible="is_warranty != 'applicable' or warranty_category in ('perpetual', False)" required="warranty_category == 'limited'"/>
                        <field name="days" force_save="1"  readonly="status not in ('draft','wfa')" invisible="is_warranty != 'applicable' or warranty_category in ('perpetual', False)" required="warranty_category == 'limited'"/>
                    </group>
                    <group> 
                        <field name="product_id" options="{'no_create': 1}" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="description" invisible="1" readonly="status not in ('draft','wfa')"/>
                        <field name="brand_id" options="{'no_create': 1}" readonly="status not in ('draft','wfa')"/>
                        <field name="uom_id" options="{'no_create': 1}" readonly="1" force_save="1"/>
                        <field name="unit_price" required="1" readonly="status not in ('draft','wfa')"/>
                        <field name="discount" force_save='1' readonly="status not in ('draft','wfa')"/>
                        <field name="discount_amt" force_save='1' readonly="status not in ('draft','wfa')"/>
                        <field name="tax_group_id" invisible="1" options="{'no_create': 1}" readonly="status not in ('draft','wfa')"/>
                        <field name="tax_ids" options="{'no_create': 1}" readonly="status not in ('draft','wfa')" widget="many2many_tags"/>
                        <field name="currency_id" options="{'no_create': 1}" force_save="1" readonly="1" />  
                        <field name="warranty_date" readonly="status not in ('draft','wfa')" invisible="warranty_from != 'custom'" required="warranty_from == 'custom'"/>
                        <field name="warranty_to_date" force_save="1" readonly="1" invisible="warranty_from != 'custom' or warranty_category == 'perpetual'"/>
                        <!-- <field name="modify" invisible = "1"/> -->
                        <field name="status" readonly = "1" force_save="1" invisible="1"/>
                    </group>
                </group>

                
                <notebook>
                    <page string="Other Charges" >
                        <field name="line_ids_b" string="Other Charges" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Other Charges" editable="bottom">

                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="expense_id" required="1" options="{'no_create': True}"/>
                                <field name="description"/>
                                <field name="amt"/>
                                <field name="disc_per" width="120px"/>
                                <field name="disc_amt" readonly="1" force_save="1" string="DV"/>
                                <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="tax_amt" readonly="1" force_save="1" string="Tax amount" width="150px"/>
                                <field name="line_tot_amt" readonly="1" force_save="1" string="Sub Total"/>
                            </tree>
                        </field>
                        <group string="Terms and Conditions">
                            <group>
                                <field name="payment_term_id" options="{'no_create': 1}" required="1" readonly="status not in ('draft','wfa')"/>
                                <!-- <field name="delivery_term_id" options="{'no_create': 1}" required="1" readonly="status not in ('draft','wfa')"/> -->
                                <field name="freight_type" required="1" readonly="status not in ('draft','wfa')"/>
                                <field name="other_charges" required="1" readonly="status not in ('draft','wfa')"/>
                                <field name="warranty" required="1" readonly="status not in ('draft','wfa')"/>
                                <field name="price"  readonly="status not in ('draft','wfa')"/>
                                <field name="more_lp_remark"  readonly="status not in ('draft','wfa')"/>
                            </group>
                            <group> 
                        </group>
                </group>
                    </page>
                    <page string="Attachments" >
                        <field name="line_ids_a" string="Attachments" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Attachments" editable="bottom">

                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="attach_desc" required="1"/>
                                <field name="attachment_ids" required="1" widget="single_file_binary" options="{'no_create_edit': True}"/>
                                <field name="attach_user_id" readonly = "1" force_save="1"/>
                                <field name="attach_date" readonly = "1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Approve / Reject Remarks">
                        <group>
                            <field name="ap_rej_remark" nolabel="1" style="width:1000px;" readonly = "status not in ('wfa')"/>
                        </group>
                    </page>
                    <page string="Expiry Remarks">
                        <group>
                            <field name="expiry_remark" nolabel="1" style="width:1000px;" readonly = "status not in ('approved')"/>
                        </group>
                    </page>
                    <page string="Entry Info">
                        <group>
                            <group>
                                <field name="company_id" force_save="1"/> 
                                <field name="fy_control_date" readonly = "1" force_save="1"/>
                                <field name="active_rpt"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="entry_mode" force_save="1"/>
                                <field name="active_trans"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="confirm_user_id" invisible="status == 'draft'" widget="many2one_avatar_user" />
                                <field name="ap_rej_user_id" invisible="status in ('draft','wfa')" widget="many2one_avatar_user" />
                                <field name="expiry_user_id" invisible="status != 'expired'" widget="many2one_avatar_user" />
                                <field name="update_user_id" widget="many2one_avatar_user" />
                            </group>
                            <group>
                                <field name="crt_date" />
                                <field name="confirm_date" invisible="status == 'draft'" />
                                <field name="ap_rej_date" invisible="status in ('draft','wfa')" />
                                <field name="expiry_date" invisible="status != 'expired'" />
                                <field name="update_date" />
                            </group>
                        </group>
                    </page>
                </notebook>
                <group>
                    <field name="remarks"/>
                </group>
                
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>  
            </sheet>
        </form>
      </field>
    </record>

    <record id="ct_vendor_price_list_tree_js" model="ir.ui.view">
        <field name="name">List Dashboard View</field>
        <field name="model">ct.vendor.price.list</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <tree string="Price List" js_class="ct_vendor_price_list_view"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-muted = "status == 'expired'">

                <field name="ref_no"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="comparison_ref_no"/>
                <field name="brand_id"/>
                <field name="uom_id"/>
                <field name="source"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-muted = "status == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="ct_vendor_price_list_tree" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">ct.vendor.price.list</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <tree string="Price List"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-muted = "status == 'expired'">

                <field name="ref_no"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="comparison_ref_no"/>
                <field name="brand_id"/>
                <field name="uom_id"/>
                <field name="source"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-muted = "status == 'expired'"/>
            </tree>
        </field>
    </record>

    <record id="ct_vendor_price_list_search" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">ct.vendor.price.list</field>
        <field name="arch" type="xml">
            <search string="Price List">
                <field name="comparison_ref_no"/>
                <field name="ref_no"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="remarks"/>

                <filter name="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="WFA" domain="[('status', '=', 'wfa')]"/>
                <filter name="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="my_entries" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <filter name="My Draft" string="My Draft" domain="[('user_id', '=', uid),('status', '=', 'draft')]"/>
                <filter name="My WFA" string="My WFA" domain="[('user_id', '=', uid),('status', '=', 'wfa')]"/>
                <filter name="My Approved" string="My Approved" domain="[('user_id', '=', uid),('status', '=', 'approved')]"/>
                <filter name="My Rejected" string="My Rejected" domain="[('user_id', '=', uid),('status', '=', 'rejected')]"/>
                <filter name="My Expired" string="My Expired" domain="[('user_id', '=', uid),('status', '=', 'expired')]"/>
                <filter name="Hidden" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Product Name" name="product_id" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Vendor Name" name="vendor_id" domain="[]" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Brand" name="brand_id" domain="[]" context="{'group_by': 'brand_id'}"/>
                    <filter string="UOM" name="uom_id" domain="[]" context="{'group_by': 'uom_id'}"/>
                    <filter string="Comparison No" name="comparison_ref_no" domain="[]" context="{'group_by': 'comparison_ref_no'}"/>
                    <filter string="Source" name="source" domain="[]" context="{'group_by': 'source'}"/>
                    <filter string="Entry Date" name="entry_date" domain="[]" context="{'group_by': 'entry_date'}"/>
                    <filter string="Created By" name="user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Confirmed By" name="confirm_user_id" domain="[]" context="{'group_by': 'confirm_user_id'}"/>
                    <filter string="Approved / Rejected By" name="ap_rej_user_id" domain="[]" context="{'group_by': 'ap_rej_user_id'}"/>
                    <filter string="Expired By" name="expiry_user_id" domain="[]" context="{'group_by': 'expiry_user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Entry Mode" name="entry_mode" domain="[]" context="{'group_by': 'entry_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ct_vendor_price_list_kanban" model="ir.ui.view">
        <field name="name">Kanban View</field>
        <field name="model">ct.vendor.price.list</field>
        <field name="arch" type="xml">
            <kanban string="Price List" class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="ref_no"/>
                <field name="ap_rej_user_id"/>
                <field name="status"/>
                <progressbar field="status"
                    colors='{"draft": "info", "wfa": "success", "approved": "bf","rejected": "warning","expired": "muted"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="kanban-card"> 
                            <div class="kanban-table">
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Order Name'">
                                        <field style="color: #4d4d4d; font-weight: bold; font-size: 18px;" name="ref_no"/>
                                    </div>
                                    <div class="kanban-cell" t-att-title="'Order Date'">
                                        <field style="color: #808080; font-weight: bold; font-size: 14px;" name="entry_date"/>
                                    </div>
                                </div>
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Approved/Reject By'">
                                        <i class="fa fa-user" style="color: #4CAF50;" title="Supplier Icon"></i> <field name="ap_rej_user_id"/>
                                    </div>
                                    <div class="kanban-cell" t-att-title="'Status'">
                                        <field name="status" widget="label_selection" options="{'classes': {'draft': 'info', 'wfa': 'success', 'approved': 'default', 'rejected': 'warning', 'expired': 'muted'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ct_vendor_price_list_graph" model="ir.ui.view">
       <field name="name">Graph View</field>
       <field name="model">ct.vendor.price.list</field>
       <field name="arch" type="xml">
            <graph string="Price List" sample="1" disable_linking="True" stacked="0" type="pie">
                <field name="status"/>
                <field name="id" string="Count" type="measure" operator="count"/>
            </graph>
        </field>
    </record>

    <record id="ct_vendor_price_list_win_action" model="ir.actions.act_window" >
      <field name="name">Price List</field>
      <field name="res_model">ct.vendor.price.list</field>
      <field name="view_mode">tree,form,kanban,graph</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="ct_vendor_price_list_tree_js"/>
        <field name="search_view_id" ref="ct_vendor_price_list_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No record found. Let's create one !
          </p><p>
            This is for base transaction.
          </p>
        </field>
    </record>

    <record id="ct_view_vendor_price_list_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="ct_vendor_price_list.ct_vendor_price_list_tree_js"/>
        <field name="act_window_id" ref="ct_vendor_price_list_win_action"/>
    </record>

    <record id="ct_view_vendor_price_list_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ct_vendor_price_list.ct_vendor_price_list_form"/>
        <field name="act_window_id" ref="ct_vendor_price_list_win_action"/>
    </record>

    <record id="ct_view_vendor_price_list_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="ct_vendor_price_list.ct_vendor_price_list_kanban"/>
        <field name="act_window_id" ref="ct_vendor_price_list_win_action"/>
    </record>

    <record id="ct_view_vendor_price_list_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="ct_vendor_price_list.ct_vendor_price_list_graph"/>
        <field name="act_window_id" ref="ct_vendor_price_list_win_action"/>
    </record>

    <menuitem name="Price List" id="ct_vendor_price_list_act_menu" parent="ct_purchase_request.ct_purchase_m_parent"
              action="ct_vendor_price_list_win_action" sequence="12"/>
  </data>
</odoo>
