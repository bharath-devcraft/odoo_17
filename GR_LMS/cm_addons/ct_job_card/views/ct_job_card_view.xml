<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="ct_job_card_form">
      <field name="name">Form View</field>
      <field name="model">ct.job.card</field>
      <field name="arch" type="xml">
        <form string="Job Card">
            <header>

                <button string="Confirm"
                    class="btn btn-primary"
                    type="object"
                    name="entry_confirm" invisible = "status != 'draft'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Approve"
                    icon="fa-thumbs-up"
                    class="btn btn-success"
                    type="object"
                    name="entry_approve" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Reject"
                    icon="fa-thumbs-down"
                    class="btn btn-danger"
                    type="object"
                    name="entry_reject" invisible = "status != 'wfa'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Cancel"
                    class="btn btn-primary"
                    type="object"
                    name="entry_cancel" invisible = "status != 'approved'"
                    confirm="Are you sure to proceed ?"/>
                <button string="Close"
                    class="btn btn-primary"
                    type="object"
                    name="entry_close" invisible = "status != 'approved'"
                    confirm="Are you sure to proceed ?"/>

                <field name="status" widget="statusbar" style="width:700px;"/>                

            </header>
            <sheet>
                <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible = "status != 'approved'"/>
                <group>
                    <group>
                        <field name="name" readonly = "1" force_save="1" class="animate-charcter" widget="CopyClipboardChar"/>
                        <field name="entry_date" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="nature_of_job" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="bc_id" required = "nature_of_job != 'expiry_audit'" 
                            readonly = "status not in ('draft','wfa')"
                            invisible = "nature_of_job in ('expiry_audit',False)" options="{'no_create': True}"/>
                        <field name="bc_date" readonly = "1" force_save="1" invisible = "nature_of_job in ('expiry_audit',False)"/>
                    </group>
                    <group>
                        <field name="service_id" readonly = "1" force_save="1" invisible = "nature_of_job in ('expiry_audit',False)" options="{'no_create': True}"/>
                        <field name="service_provider" required = "1" readonly = "status not in ('draft','wfa')"/>
                        <field name="bcc_date" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Customer Details">
                    <group>
                        <field name="customer_id" required="nature_of_job == 'expiry_audit'"
                            readonly = "nature_of_job != 'expiry_audit' or status not in ('draft','wfa')" 
                            force_save="1" options="{'no_create': True}"/>
                        <field name="service_address" readonly = "1" force_save="1" 
                            invisible="nature_of_job in ('expiry_audit',False)" options="{'no_create': True}"/>
                        <field name="service_date" required = "nature_of_job in 
                            ('container_survey','loading','unloading','cross_loading','disposal_assistance')" 
                            readonly = "status not in ('draft','wfa')"
                            invisible="nature_of_job in ('expiry_audit',False)"/>
                        <field name="exp_contact_person" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="exp_mobile_no" widget="numeric" readonly = "1" force_save="1"/>
                        <field name="exp_email" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Service Engineer Details" invisible="service_provider != 'internal'">
                    <group>
                        <field name="emp_id" required = "service_provider == 'internal'" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="mobile_no" widget="numeric" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="email" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="External Vendor Details" invisible="service_provider != 'external'">
                    <group>                        
                        <field name="vendor_id" required = "service_provider == 'external'" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="contact_person" readonly = "1" force_save="1"/>
                    </group>
                    <group>
                        <field name="mobile_no" widget="numeric" readonly = "1" force_save="1"/>
                        <field name="email" readonly = "1" force_save="1"/>
                    </group>
                </group>
                <group string="Expiry Audit Details" invisible="nature_of_job != 'expiry_audit'">
                    <group>
                        <field name="available_loc" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                        <field name="dc_id" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="exp_vendor_id" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="flexi_bag_id" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="serial_no" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                        <field name="mfg_date" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                        <field name="expiry_date" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                    </group>
                    <group>
                        <field name="audit_date" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                        <field name="audit_eng_id" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')" options="{'no_create': True}"/>
                        <field name="audit_address" required = "nature_of_job == 'expiry_audit' and available_loc == 'customer_place'"
                            readonly = "status not in ('draft','wfa') or available_loc != 'customer_place'"/>
                        <field name="audit_result" required = "nature_of_job == 'expiry_audit'" readonly = "status not in ('draft','wfa')"/>
                        <field name="extended_usage" required = "nature_of_job == 'expiry_audit' and audit_result == 'reusable'" 
                            readonly = "status not in ('draft','wfa')"
                            invisible="audit_result != 'reusable'"/>
                        <field name="extended_expiry_date" readonly = "1" invisible="audit_result != 'reusable'"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="combined_codes" readonly = "1" force_save="1" invisible="1"/>
                    </group>
                    <group>
                        <field name="status" readonly = "1" force_save="1" invisible="1"/>
                    </group>
                </group>

                
                <notebook>
                    <page string="Bag Details" invisible="(nature_of_job not in 
                        ('container_survey','loading','unloading','cross_loading','disposal_assistance'))
                        or ('FLAS' not in combined_codes and 'FLBS' not in combined_codes)">
                        <field name="line_ids_c" string="Bag Details" colspan="4" nolabel="1" readonly = "1" force_save="1">
                            <tree string="Bag Details" editable="top" create="0" delete="0">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="flexi_bag_id" options="{'no_create': True}"/>
                                <field name="uom_id" options="{'no_create': True}"/>
                                <field name="qty" width="200px"/>
                                <field name="vendor_id" options="{'no_create': True}"/>
                                <field name="notes"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <separator />
                <notebook>
                    <page string="Container Details" invisible="nature_of_job not in 
                        ('container_survey','loading','unloading','cross_loading','disposal_assistance')">
                        <field name="line_ids_d" string="Container Details" colspan="4" nolabel="1" readonly = "entry_mode == 'auto' or status not in ('draft','wfa')" force_save="1">
                            <tree string="Container Details" editable="top">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="container_no"/>
                                <field name="container_size"/>
                                <field name="serial_no" required="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <separator />
                <notebook>
                    <page string="Advance Details">
                        <field name="line_ids_g" string="Advance Details" colspan="4" nolabel="1" readonly = "entry_mode == 'auto' or status not in ('draft','wfa')" force_save="1">
                            <tree string="Advance Details" editable="top">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="chrg_head_id" required="1" options="{'no_create': True}"/>
                                <field name="emp_id" required="1" options="{'no_create': True}"/>
                                <field name="value" required="1"/>
                                <field name="currency_id" required="1" options="{'no_create': True}"/>
                                <field name="notes"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <notebook>
                    <page string="Expense Details">
                        <field name="line_ids_f" string="Expense Details" colspan="4" nolabel="1" readonly = "entry_mode == 'auto' or status not in ('draft','wfa')" force_save="1">
                            <tree string="Expense Details" editable="top">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="chrg_head_id" required="1" options="{'no_create': True}"/>
                                <field name="emp_id" required="1" options="{'no_create': True}"/>
                                <field name="value" required="1"/>
                                <field name="currency_id" required="1" options="{'no_create': True}"/>
                                <field name="notes"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Checklist" invisible="nature_of_job not in 
                        ('loading','unloading','cross_loading')">
                        <field name="line_ids_e" string="Checklist" colspan="4" nolabel="1" readonly = "entry_mode == 'auto' or status not in ('draft','wfa')" force_save="1">
                            <tree string="Checklist" editable="top">
                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="description" required="1"/>
                                <field name="is_applicable" required="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Attachments" >
                        <field name="line_ids_a" string="Attachments" colspan="4" nolabel="1" readonly = "status not in ('draft','wfa')">
                            <tree string="Attachments" editable="bottom">

                                <field name="status" column_invisible="1"/>
                                <field name="header_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="attach_desc" required="1"/>
                                <field name="attachment_ids" required="1" widget="single_file_binary" options="{'no_create_edit': True}"/>
                                <field name="attach_user_id" readonly = "1" force_save="1"/>
                                <field name="attach_date" readonly = "1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Approve / Reject Remarks">
                        <group>
                            <field name="ap_rej_remark" nolabel="1" style="width:1000px;" readonly = "status in ('approved','cancelled','rejected','closed')"/>
                        </group>
                    </page>
                    <page string="Cancel Remarks">
                        <group>
                            <field name="cancel_remark" nolabel="1" style="width:1000px;" readonly = "status in ('cancelled','rejected')"/>
                        </group>
                    </page>
                    <page string="Entry Info">
                        <group>
                            <group>
                                <field name="company_id" force_save="1"/> 
                                <field name="fy_control_date" readonly = "1" force_save="1"/>
                                <field name="active_rpt"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="entry_mode" force_save="1"/>
                                <field name="active_trans"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="confirm_user_id" invisible="status == 'draft'" widget="many2one_avatar_user" />
                                <field name="ap_rej_user_id" invisible="status in ('draft','wfa')" widget="many2one_avatar_user" />
                                <field name="cancel_user_id" invisible="status != 'cancelled'" widget="many2one_avatar_user" />
                                <field name="close_user_id" invisible="status != 'closed'" widget="many2one_avatar_user" />
                                <field name="update_user_id" widget="many2one_avatar_user" />
                            </group>
                            <group>
                                <field name="crt_date" />
                                <field name="confirm_date" invisible="status == 'draft'" />
                                <field name="ap_rej_date" invisible="status in ('draft','wfa')" />
                                <field name="cancel_date" invisible="status != 'cancelled'" />
                                <field name="close_date" invisible="status != 'closed'" />
                                <field name="update_date" />
                            </group>
                        </group>
                    </page>
                </notebook>
                <group string="Closer Details" invisible = "status not in ('closed','approved')">
                    <group>
                        <field name="closer_date" readonly = "status not in ('approved')"/>
                    </group>
                    <group>
                        <field name="closer_remark" readonly = "status not in ('approved')"/>
                    </group>
                </group>
                <group>
                    <field name="remarks"/>
                </group>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>  
            </sheet>
        </form>
      </field>
    </record>

    <record id="ct_job_card_tree_js" model="ir.ui.view">
        <field name="name">List Dashboard View</field>
        <field name="model">ct.job.card</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <tree string="Job Card" js_class="ct_job_card_list"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'"
                decoration-muted = "status == 'closed'">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="bc_id"/>
                <field name="bc_date"/>
                <field name="service_id"/>
                <field name="nature_of_job"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"
                    decoration-muted = "status == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="ct_job_card_tree" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">ct.job.card</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <tree string="Job Card"
                sample="1"
                decoration-info = "status == 'draft'"
                decoration-success = "status == 'wfa'"
                decoration-bf = "status in ('approved','draft')"
                decoration-warning = "status == 'rejected'"
                decoration-primary = "status == 'cancelled'"
                decoration-muted = "status == 'closed'">

                <field name="name" decoration-bf="1"/>
                <field name="entry_date"/>
                <field name="bc_id"/>
                <field name="bc_date"/>
                <field name="service_id"/>
                <field name="nature_of_job"/>
                <field name="status" widget="badge" 
                    decoration-info = "status == 'draft'"
                    decoration-success = "status == 'wfa'"
                    decoration-bf = "status == 'approved'"
                    decoration-warning = "status == 'rejected'"
                    decoration-primary = "status == 'cancelled'"
                    decoration-muted = "status == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="ct_job_card_search" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">ct.job.card</field>
        <field name="arch" type="xml">
            <search string="Job Card">
                <field name="name"/>
                <field name="bc_id"/>

                <filter name="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="WFA" domain="[('status', '=', 'wfa')]"/>
                <filter name="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter name="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="Closed" domain="[('status', '=', 'closed')]"/>
                <filter name="my_entries" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <filter name="My Draft" string="My Draft" domain="[('user_id', '=', uid),('status', '=', 'draft')]"/>
                <filter name="My WFA" string="My WFA" domain="[('user_id', '=', uid),('status', '=', 'wfa')]"/>
                <filter name="My Approved" string="My Approved" domain="[('user_id', '=', uid),('status', '=', 'approved')]"/>
                <filter name="My Cancelled" string="My Cancelled" domain="[('user_id', '=', uid),('status', '=', 'cancelled')]"/>
                <filter name="My Rejected" string="My Rejected" domain="[('user_id', '=', uid),('status', '=', 'rejected')]"/>
                <filter name="My Closed" string="My Closed" domain="[('user_id', '=', uid),('status', '=', 'closed')]"/>
                <filter name="Hidden" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="JC Date" name="entry_date" domain="[]" context="{'group_by': 'entry_date'}"/>
                    <filter string="Service Name" name="service_id" domain="[]" context="{'group_by': 'service_id'}"/>
                    <filter string="Nature Of Job" name="nature_of_job" domain="[]" context="{'group_by': 'nature_of_job'}"/>
                    <filter string="Service Provider" name="service_provider" domain="[]" context="{'group_by': 'service_provider'}"/>
                    <filter string="Created By" name="user_id" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Confirmed By" name="confirm_user_id" domain="[]" context="{'group_by': 'confirm_user_id'}"/>
                    <filter string="Approved / Rejected By" name="ap_rej_user_id" domain="[]" context="{'group_by': 'ap_rej_user_id'}"/>
                    <filter string="Cancelled By" name="cancel_user_id" domain="[]" context="{'group_by': 'cancel_user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Entry Mode" name="entry_mode" domain="[]" context="{'group_by': 'entry_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ct_job_card_kanban" model="ir.ui.view">
        <field name="name">Kanban View</field>
        <field name="model">ct.job.card</field>
        <field name="arch" type="xml">
            <kanban string="Job Card" class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="name"/>
                <field name="entry_date"/>
                <field name="status"/>
                <progressbar field="status"
                    colors='{"draft": "info", "wfa": "success", "approved": "bf","cancelled": "primary","rejected": "warning"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="kanban-card"> 
                            <div class="kanban-table">
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'JC No'">
                                        <field style="color: #4d4d4d; font-weight: bold; font-size: 18px;" name="name"/>
                                    </div>
                                    <div class="kanban-cell" t-att-title="'JC Date'">
                                        <field style="color: #808080; font-weight: bold; font-size: 14px;" name="entry_date"/>
                                    </div>
                                </div>
                                <div class="kanban-row">
                                    <div class="kanban-cell" t-att-title="'Status'">
                                        <field name="status" widget="label_selection" options="{'classes': {'draft': 'info', 'wfa': 'success', 'approved': 'default', 'cancelled': 'primary', 'rejected': 'warning'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ct_job_card_graph" model="ir.ui.view">
       <field name="name">Graph View</field>
       <field name="model">ct.job.card</field>
       <field name="arch" type="xml">
            <graph string="Job Card" sample="1" disable_linking="True" stacked="0" type="pie">
                <field name="status"/>
                <field name="id" string="Count" type="measure" operator="count"/>
            </graph>
        </field>
    </record>

    <record id="ct_job_card_win_action" model="ir.actions.act_window" >
      <field name="name">Job Card</field>
      <field name="res_model">ct.job.card</field>
      <field name="view_mode">tree,form,kanban,graph</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="ct_job_card_tree_js"/>
        <field name="search_view_id" ref="ct_job_card_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No record found. Let's create one !
          </p><p>
            This is for base transaction.
          </p>
        </field>
    </record>

    <record id="ct_view_job_card_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="ct_job_card.ct_job_card_tree_js"/>
        <field name="act_window_id" ref="ct_job_card_win_action"/>
    </record>

    <record id="ct_view_job_card_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ct_job_card.ct_job_card_form"/>
        <field name="act_window_id" ref="ct_job_card_win_action"/>
    </record>

    <record id="ct_view_job_card_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="ct_job_card.ct_job_card_kanban"/>
        <field name="act_window_id" ref="ct_job_card_win_action"/>
    </record>

    <record id="ct_view_job_card_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="ct_job_card.ct_job_card_graph"/>
        <field name="act_window_id" ref="ct_job_card_win_action"/>
    </record>

    <menuitem name="Job Card" id="ct_job_card_act_menu" parent="ct_business_confirmation.ct_flexi_m_parent"
              action="ct_job_card_win_action" sequence="11"/>
  </data>
</odoo>
