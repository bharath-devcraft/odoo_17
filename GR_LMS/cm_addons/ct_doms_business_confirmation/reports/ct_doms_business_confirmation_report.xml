<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_ct_doms_business_confirmation" model="ir.actions.report">
            <field name="name">Business Confirmation Print</field>
            <field name="model">ct.doms.business.confirmation</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ct_doms_business_confirmation.report_ct_doms_business_confirmation</field>
            <field name="report_file">ct_doms_business_confirmation.report_ct_doms_business_confirmation</field>
            <field name="print_report_name">
                (object.status in ('approved') and 'Transaction Print - %s' % (object.name) or
                'Transaction Print')</field>
            <field name="binding_model_id" ref="model_ct_doms_business_confirmation"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
