        <record id="action_report_ct_sales_lead" model="ir.actions.report">
            <field name="name">Sales Visit Print</field>
            <field name="model">ct.sales.lead</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ct_sales_lead.report_ct_sales_lead</field>
